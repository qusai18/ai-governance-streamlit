# Copy to .streamlit/secrets.toml (git-ignored) when running OUTSIDE Databricks Apps:
# on your laptop or on Streamlit Community Cloud (paste into App settings > Secrets).
# As a Databricks App none of this is needed: the platform injects everything.

[lakebase]
endpoint = "projects/ai-governance/branches/production/endpoints/primary"
host = "ep-jolly-night-d20poldx.database.us-east-1.cloud.databricks.com"
database = "databricks_postgres"
schema = "aigov"
# user = ""   # Postgres role; defaults to the Databricks identity below

[databricks]
host = "https://dbc-119bd90e-bff1.cloud.databricks.com"
# --- Option A, laptop: use your Databricks CLI login (databricks auth login --profile DEFAULT)
profile = "DEFAULT"
# --- Option B, Streamlit Cloud: a dedicated service principal (OAuth M2M). Never a personal token.
# client_id = "<service principal application id>"
# client_secret = "<service principal OAuth secret>"

[app]
# Laptop only: skip sign-in. Never set this on a shared deployment.
allow_unauthenticated = true
# Optional allow-list when [auth] is configured:
# allowed_domains = ["icf.com"]
# allowed_emails = ["someone@icf.com"]

# Sign-in for Streamlit Cloud (Streamlit's built-in OIDC, st.login). Example: Microsoft Entra ID.
# [auth]
# redirect_uri = "https://<your-app>.streamlit.app/oauth2callback"
# cookie_secret = "<long random string>"
# client_id = "<OIDC client id>"
# client_secret = "<OIDC client secret>"
# server_metadata_url = "https://login.microsoftonline.com/<tenant-id>/v2.0/.well-known/openid-configuration"
